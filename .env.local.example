# Заполним на шаге 2, когда подключим Supabase.
# Скопируй этот файл в .env.local и вставь свои значения — .env.local никогда не коммитится в git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Push-нагадування (крок "push-повідомлення") — заповнити у Vercel, не тут.
# SUPABASE_SERVICE_ROLE_KEY: Supabase -> Project Settings -> API -> service_role
# VAPID-ключі: згенеровані одноразово, Claude дав їх у чаті
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sashafit.app
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
